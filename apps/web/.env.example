# App
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_APP_NAME=KameOps
SKIP_ENV_VALIDATION=1

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kame_ops
DIRECT_URL=

# Auth (NextAuth — migrate to Supabase Auth later)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_URL=http://localhost:3005

# Optional OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PUBLIC=kame-ops-public
SUPABASE_STORAGE_BUCKET_PRIVATE=kame-ops-private

# Cron / webhooks
CRON_SECRET=change-me-cron-secret
TELEGRAM_WEBHOOK_SECRET=
# User UUID (from db:seed) for Telegram webhook mark-paid routing
TELEGRAM_DEFAULT_USER_ID=

# Encryption for integration secrets and card passwords (32+ chars)
ENCRYPTION_KEY=change-me-32-byte-encryption-key-here!!

# Dev admin (seed user)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123

# Legacy-style notify (per-user integrations preferred in DB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEB_LINK=
SLACK_WEBHOOK_URL=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_AUTO=0

# Reminders
DUE_REMINDERS_WINDOW_DAYS=4

# AI (optional)
OPENAI_API_KEY=

# Receipt OCR
RECEIPT_TESSERACT_PSM=6
RECEIPT_REQUIRE_TOTAL_DUE=0
BPI_OCR=1
