# App
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_APP_NAME=KameOps
SKIP_ENV_VALIDATION=1

# Database — local Docker (default) OR Supabase (uncomment block below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kame_ops
DIRECT_URL=

# --- Supabase Postgres (Dashboard → Settings → Database → Connection string) ---
# Transaction pooler (app runtime, port 6543) — copy host verbatim from dashboard (aws-0 or aws-1):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session mode (db:push / migrations, port 5432):
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Auth (Google OAuth — required for sign-in and Gmail SOA access)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_URL=http://localhost:3005

# Google Cloud OAuth (Web application client)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PUBLIC=kame-ops-public
SUPABASE_STORAGE_BUCKET_PRIVATE=kame-ops-private

# Cron / webhooks
CRON_SECRET=change-me-cron-secret
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_USER_ID=

# Encryption for integration secrets and card passwords (32+ chars)
ENCRYPTION_KEY=change-me-32-byte-encryption-key-here!!

# Legacy-style notify (per-user integrations preferred in DB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEB_LINK=
SLACK_WEBHOOK_URL=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_AUTO=0

# Reminders
DUE_REMINDERS_WINDOW_DAYS=4

# AI (optional)
OPENAI_API_KEY=

# Receipt OCR
RECEIPT_TESSERACT_PSM=6
RECEIPT_REQUIRE_TOTAL_DUE=0
BPI_OCR=1
