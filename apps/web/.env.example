# App
NEXT_PUBLIC_APP_URL=http://localhost:3005
NEXT_PUBLIC_APP_NAME=KameOps
SKIP_ENV_VALIDATION=1

# Database — local Docker (default) OR Supabase (uncomment block below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kame_ops
DIRECT_URL=

# --- Supabase Postgres (Dashboard → Settings → Database → Connection string) ---
# Transaction pooler (app runtime, port 6543) — copy host verbatim from dashboard (aws-0 or aws-1):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session mode (db:push / migrations, port 5432):
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Auth (Google OAuth — required for sign-in and Gmail SOA access)
# On production, AUTH_URL must match NEXT_PUBLIC_APP_URL (e.g. https://your-app.vercel.app).
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_URL=http://localhost:3005

# Google Cloud OAuth (Web application client)
# Authorized redirect URIs (add BOTH in Google Cloud Console → Credentials → OAuth client):
#   {AUTH_URL or NEXT_PUBLIC_APP_URL}/api/auth/callback/google          — sign-in (NextAuth)
#   {AUTH_URL or NEXT_PUBLIC_APP_URL}/api/auth/google/link/callback     — Connect / Add Google account (Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PUBLIC=kame-ops-public
SUPABASE_STORAGE_BUCKET_PRIVATE=kame-ops-private

# Cron / webhooks
CRON_SECRET=change-me-cron-secret
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_USER_ID=

# Encryption for integration secrets and card passwords (32+ chars)
ENCRYPTION_KEY=change-me-32-byte-encryption-key-here!!

# Legacy-style notify (per-user integrations preferred in DB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEB_LINK=
SLACK_WEBHOOK_URL=

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_AUTO=0

# Reminders
DUE_REMINDERS_WINDOW_DAYS=4

# AI — receipt validation (Gemini primary, Groq fallback)
# Comma-separated keys rotate on rate limits (429) or server errors.
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEY=

# Optional legacy OpenAI
OPENAI_API_KEY=

# Receipt mark-paid threshold (minimum vs total due)
RECEIPT_REQUIRE_TOTAL_DUE=0

# SOA PDF OCR (separate from receipt validation).
# OCR is triggered automatically for ANY bank once extracted PDF text looks unusable
# (empty, no peso amounts/dates, garbled glyphs) — no flag required for that to kick in.
# These only override the default:
# SOA_OCR_FORCE=all        # or a comma-separated issuer list (e.g. "bpi,rcbc"); forces OCR even when text looks fine
# SOA_OCR_DISABLE=         # comma-separated issuer list, or "all", to turn OCR off entirely
# SOA_OCR_PAGES=0          # max pages to OCR per PDF; 0 = all pages
# SOA_OCR_SCALE=3          # rasterization scale (1.5–4; higher = sharper/slower)
# SOA_OCR_PSM=             # Tesseract page segmentation mode override (e.g. 4, 6, 11)
# SOA_OCR_DUAL=0           # also run a sparse-text pass and merge (helps scattered labels)
# SOA_OCR_DEBUG=0          # save raw OCR text under data/output/YYYY-MM/
# BPI_OCR* (BPI_OCR, BPI_OCR_PAGES, BPI_OCR_SCALE, BPI_OCR_PSM, BPI_OCR_DUAL, BPI_OCR_DEBUG)
# are kept as BPI-only legacy aliases for the SOA_OCR_* vars above.
BPI_OCR=1
