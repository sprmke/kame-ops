# Component Rules

## Component Structure

```typescript
// components/bookings/BookingCard.tsx

// 1. Imports (organized by type)
import { useState } from 'react';
import { format } from 'date-fns';

import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';

import { formatCurrency } from '@/lib/utils/format';

import { type Booking } from '@/types/models';

// 2. Props interface (co-located with component)
interface BookingCardProps {
  booking: Booking;
  onView?: (id: string) => void;
  onEdit?: (id: string) => void;
  className?: string;
}

// 3. Component (named export)
export function BookingCard({ 
  booking, 
  onView, 
  onEdit, 
  className 
}: BookingCardProps) {
  // 4. Hooks
  const [isExpanded, setIsExpanded] = useState(false);

  // 5. Derived state / computations
  const totalAmount = booking.payments?.reduce((sum, p) => sum + p.amount, 0) ?? 0;

  // 6. Event handlers
  const handleViewClick = () => {
    onView?.(booking.id);
  };

  // 7. Render
  return (
    <Card className={className}>
      <CardHeader>
        <CardTitle>{booking.bookingNumber}</CardTitle>
        <Badge variant={getStatusVariant(booking.status)}>
          {booking.status}
        </Badge>
      </CardHeader>
      <CardContent>
        <p>{booking.guestName}</p>
        <p>{format(booking.checkInDate, 'MMM d, yyyy')}</p>
        <p>{formatCurrency(totalAmount)}</p>
        <Button onClick={handleViewClick}>View Details</Button>
      </CardContent>
    </Card>
  );
}

// 8. Helper functions (below component or in separate file)
function getStatusVariant(status: string) {
  switch (status) {
    case 'PENDING_REVIEW': return 'warning';
    case 'CHECKED_IN': return 'success';
    case 'CANCELLED': return 'destructive';
    default: return 'default';
  }
}
```

## Component Patterns

### Loading States

```typescript
// Always handle loading, error, and empty states
export function BookingsList({ propertyId }: { propertyId: string }) {
  const { data, isLoading, error } = api.bookings.list.useQuery({ propertyId });

  // Early returns for states
  if (isLoading) return <LoadingSpinner />;
  if (error) return <ErrorMessage error={error} />;
  if (!data?.data.length) return <EmptyState message="No bookings found" />;

  // Main render
  return (
    <ul>
      {data.data.map((booking) => (
        <BookingCard key={booking.id} booking={booking} />
      ))}
    </ul>
  );
}
```

### Compound Components

```typescript
// For complex components with multiple parts
interface BookingDetailProps {
  booking: Booking;
  children: React.ReactNode;
}

export function BookingDetail({ booking, children }: BookingDetailProps) {
  return (
    <BookingContext.Provider value={booking}>
      <div className="booking-detail">{children}</div>
    </BookingContext.Provider>
  );
}

BookingDetail.Header = function Header() {
  const booking = useBookingContext();
  return <header>{booking.bookingNumber}</header>;
};

BookingDetail.Content = function Content() {
  const booking = useBookingContext();
  return <main>{booking.guestName}</main>;
};

BookingDetail.Actions = function Actions() {
  return <div className="actions">...</div>;
};

// Usage
<BookingDetail booking={booking}>
  <BookingDetail.Header />
  <BookingDetail.Content />
  <BookingDetail.Actions />
</BookingDetail>
```

### Controlled vs Uncontrolled

```typescript
// Controlled - parent manages state
interface ControlledInputProps {
  value: string;
  onChange: (value: string) => void;
}

export function ControlledInput({ value, onChange }: ControlledInputProps) {
  return (
    <input 
      value={value} 
      onChange={(e) => onChange(e.target.value)} 
    />
  );
}

// Uncontrolled with default
interface UncontrolledInputProps {
  defaultValue?: string;
  onValueChange?: (value: string) => void;
}

export function UncontrolledInput({ defaultValue, onValueChange }: UncontrolledInputProps) {
  const [value, setValue] = useState(defaultValue ?? '');
  
  const handleChange = (newValue: string) => {
    setValue(newValue);
    onValueChange?.(newValue);
  };

  return (
    <input 
      value={value} 
      onChange={(e) => handleChange(e.target.value)} 
    />
  );
}
```

