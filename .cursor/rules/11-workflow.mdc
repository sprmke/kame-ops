## Before Starting Any Feature

1. **Check Documentation**
   - Read `@docs/product/user-flows.md` for the feature
   - Review `@docs/reference/feature-specifications.md` for technical details
   - Check `@docs/database/schema.md` and `@docs/reference/application-inventory.md` for data models and current state

2. **Check Current Phase**
   - Verify the feature is in the current phase
   - Don't skip ahead without completing dependencies

3. **Check Existing Code**
   - Look for similar patterns in codebase
   - Reuse existing components and utilities
   - Check if shared code exists before creating feature-specific code

## Feature-Based Development Flow

When creating a new feature, follow this order:

```
1. Create Feature Folder Structure
   └── src/features/{feature}/
       ├── api/           # If needs API hooks
       ├── components/    # If needs UI components
       ├── hooks/         # If needs custom hooks
       ├── stores/        # If needs local state
       ├── types/         # If needs specific types
       └── utils/         # If needs utilities

2. Create/Update Database Schema (if needed)
   └── packages/database/src/schema/{feature}.ts

3. Create Service Layer
   └── src/server/services/{feature}.service.ts

4. Create tRPC Router
   └── src/server/routers/{feature}.ts

5. Create Feature Types
   └── src/features/{feature}/types/index.ts

6. Create API Hooks
   └── src/features/{feature}/api/
       ├── use-{feature}.ts         # Query hooks
       └── use-{feature}-mutations.ts

7. Create Feature Components
   └── src/features/{feature}/components/
       ├── {Feature}List.tsx
       ├── {Feature}Card.tsx
       └── {Feature}Form.tsx

8. Create Feature Hooks (if needed)
   └── src/features/{feature}/hooks/

9. Create Pages/Routes
   └── src/app/(dashboard)/{feature}/page.tsx

10. Write Tests
    └── __tests__/unit/features/{feature}/
```

## Creating a New Feature - Step by Step

### Step 1: Create Feature Directory

```bash
# Create the feature folder with necessary subfolders
mkdir -p src/features/new-feature/{api,components,hooks,types,utils}
```

### Step 2: Define Types

```typescript
// src/features/new-feature/types/index.ts
export interface NewFeatureItem {
  id: string;
  name: string;
  // ... other fields
}

export interface NewFeatureFilters {
  search?: string;
  status?: string;
}
```

### Step 3: Create API Hooks

```typescript
// src/features/new-feature/api/use-new-feature.ts
import { api } from '@/lib/api/client';

export function useNewFeature(filters: NewFeatureFilters) {
  return api.newFeature.list.useQuery(filters, {
    staleTime: 1000 * 60 * 5, // 5 minutes
  });
}

export function useNewFeatureById(id: string) {
  return api.newFeature.byId.useQuery({ id }, { enabled: !!id });
}
```

```typescript
// src/features/new-feature/api/use-new-feature-mutations.ts
import { api } from '@/lib/api/client';
import { toast } from 'sonner';

export function useNewFeatureMutations() {
  const utils = api.useUtils();

  const create = api.newFeature.create.useMutation({
    onSuccess: () => {
      toast.success('Created successfully');
      utils.newFeature.list.invalidate();
    },
    onError: (error) => {
      toast.error(error.message);
    },
  });

  const update = api.newFeature.update.useMutation({
    onSuccess: () => {
      toast.success('Updated successfully');
      utils.newFeature.list.invalidate();
    },
    onError: (error) => {
      toast.error(error.message);
    },
  });

  return { create, update };
}
```

### Step 4: Create Components

```typescript
// src/features/new-feature/components/NewFeatureList.tsx
import { useNewFeature } from '../api/use-new-feature';
import { NewFeatureCard } from './NewFeatureCard';
import { LoadingSpinner } from '@/components/shared/LoadingSpinner';
import { EmptyState } from '@/components/shared/EmptyState';

interface NewFeatureListProps {
  propertyId: string;
}

export function NewFeatureList({ propertyId }: NewFeatureListProps) {
  const { data, isLoading, error } = useNewFeature({ propertyId });

  if (isLoading) return <LoadingSpinner />;
  if (error) return <div>Error: {error.message}</div>;
  if (!data?.length) return <EmptyState message="No items found" />;

  return (
    <div className="grid gap-4">
      {data.map((item) => (
        <NewFeatureCard key={item.id} item={item} />
      ))}
    </div>
  );
}
```

### Step 5: Create Page

```typescript
// src/app/(dashboard)/[orgId]/properties/[propertyId]/new-feature/page.tsx
import { NewFeatureList } from '@/features/new-feature/components/NewFeatureList';

interface PageProps {
  params: { propertyId: string };
}

export default function NewFeaturePage({ params }: PageProps) {
  return (
    <div>
      <h1>New Feature</h1>
      <NewFeatureList propertyId={params.propertyId} />
    </div>
  );
}
```

## Import Rules

### Feature Imports

```typescript
// ✅ Good - Direct imports from features
import { BookingCard } from '@/features/bookings/components/BookingCard';
import { useBookings } from '@/features/bookings/api/use-bookings';

// ✅ Good - Shared imports
import { Button } from '@/components/ui/button';
import { useDebounce } from '@/hooks/use-debounce';

// ❌ Bad - Cross-feature imports
import { PaymentsList } from '@/features/payments/components/PaymentsList';
// (Don't import from another feature inside a feature)

// ❌ Bad - Barrel imports
import { BookingCard, useBookings } from '@/features/bookings';
```

### Compose Features at App Level

```typescript
// ✅ Good - Compose in page component
// app/(dashboard)/[orgId]/properties/[propertyId]/page.tsx
import { PropertyHeader } from '@/features/properties/components/PropertyHeader';
import { BookingsSummary } from '@/features/bookings/components/BookingsSummary';
import { PaymentsSummary } from '@/features/payments/components/PaymentsSummary';

export default function PropertyPage({ params }) {
  return (
    <div>
      <PropertyHeader propertyId={params.propertyId} />
      <BookingsSummary propertyId={params.propertyId} />
      <PaymentsSummary propertyId={params.propertyId} />
    </div>
  );
}
```

## Git Workflow

### Branch Naming

```
feature/bookings
feature/bookings/status-timeline
fix/bookings/calendar-overlap
refactor/payments/service
docs/api-documentation
chore/update-dependencies
```

### Commit Messages

Use conventional commits:

```
feat(bookings): add status timeline component
fix(calendar): resolve date overlap issue
docs(api): update booking endpoint documentation
refactor(payments): simplify calculation logic
test(bookings): add service tests
chore: update dependencies
style(bookings): format components
perf(bookings): optimize list query
```

### Pull Request Process

1. Create feature branch from `main`
2. Implement feature following patterns
3. Write tests
4. Run linting: `bun run lint`
5. Run tests: `bun run test`
6. Create PR with description
7. Request review
8. Address feedback
9. Merge to `main`

## Development Commands

```bash
# Start development server
bun run dev

# Build for production
bun run build

# Run linting
bun run lint

# Fix lint issues
bun run lint --fix

# Run type checking
bun run type-check

# Run tests
bun run test

# Run E2E tests
bun run test:e2e

# Database commands
bun run db:generate    # Generate migrations
bun run db:migrate     # Run migrations
bun run db:push        # Push schema (dev only)
bun run db:studio      # Open Drizzle Studio
bun run db:seed        # Seed database

# Format code
bun run format
```

