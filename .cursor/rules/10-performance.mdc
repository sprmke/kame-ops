## Database Query Optimization

### Avoid N+1 Queries

```typescript
// ✅ Good - Single query with relations
const bookings = await db.query.bookings.findMany({
  where: eq(bookings.propertyId, propertyId),
  with: {
    property: true,
    payments: true,
    createdBy: { columns: { name: true } },
  },
});

// ❌ Bad - N+1 queries
const bookings = await db.select().from(bookings);
for (const booking of bookings) {
  const property = await db.query.properties.findFirst({
    where: eq(properties.id, booking.propertyId)
  });
  booking.property = property; // N extra queries!
}
```

### Select Only Needed Columns

```typescript
// ✅ Good - Select specific columns
const bookings = await db.query.bookings.findMany({
  columns: {
    id: true,
    bookingNumber: true,
    guestName: true,
    status: true,
  },
  with: {
    property: {
      columns: { name: true },
    },
  },
});

// ❌ Bad - Select everything
const bookings = await db.query.bookings.findMany({
  with: {
    property: true, // Gets all columns
    payments: true, // Gets all columns
  },
});
```

### Always Paginate

```typescript
// ✅ Always paginate list queries
const results = await db.query.bookings.findMany({
  limit: 20,
  offset: (page - 1) * 20,
  orderBy: [desc(bookings.createdAt)],
});

// Return total for pagination UI
const [{ count }] = await db
  .select({ count: sql<number>`count(*)` })
  .from(bookings)
  .where(conditions);
```

### Use Indexes

```typescript
// In schema, add indexes for frequently queried columns
export const bookings = pgTable('bookings', {
  // ...columns
}, (table) => ({
  propertyIdx: index('bookings_property_idx').on(table.propertyId),
  statusIdx: index('bookings_status_idx').on(table.status),
  checkInIdx: index('bookings_check_in_idx').on(table.checkInDate),
  // Composite index for common queries
  propertyStatusIdx: index('bookings_property_status_idx').on(table.propertyId, table.status),
}));
```

## TanStack Query Caching

### Stale Time Configuration

```typescript
// Configure stale time based on data volatility
const { data } = api.bookings.list.useQuery(
  { propertyId },
  {
    staleTime: 1000 * 60 * 5, // 5 minutes for lists
    gcTime: 1000 * 60 * 30,   // Keep in cache for 30 min
  }
);

// Static data - longer stale time
const { data: property } = api.properties.getById.useQuery(
  { id: propertyId },
  {
    staleTime: 1000 * 60 * 60, // 1 hour
  }
);
```

### Prefetching

```typescript
// Prefetch on hover
function BookingLink({ bookingId }) {
  const utils = api.useUtils();

  return (
    <Link
      href={`/bookings/${bookingId}`}
      onMouseEnter={() => {
        utils.bookings.getById.prefetch({ id: bookingId });
      }}
    >
      View Booking
    </Link>
  );
}

// Prefetch in page (Server Component)
export default async function PropertyPage({ params }) {
  // Prefetch data for client
  await Promise.all([
    utils.bookings.list.prefetch({ propertyId: params.id }),
    utils.calendar.getData.prefetch({ propertyId: params.id }),
  ]);

  return <PropertyContent propertyId={params.id} />;
}
```

### Optimistic Updates

```typescript
const updateStatus = api.bookings.updateStatus.useMutation({
  onMutate: async (newData) => {
    // Cancel outgoing refetches
    await utils.bookings.getById.cancel({ id: newData.id });

    // Snapshot previous value
    const previousBooking = utils.bookings.getById.getData({ id: newData.id });

    // Optimistically update
    utils.bookings.getById.setData(
      { id: newData.id },
      (old) => old ? { ...old, status: newData.status } : old
    );

    return { previousBooking };
  },
  onError: (err, newData, context) => {
    // Rollback on error
    utils.bookings.getById.setData(
      { id: newData.id },
      context?.previousBooking
    );
  },
  onSettled: (data, error, variables) => {
    // Always refetch after error or success
    utils.bookings.getById.invalidate({ id: variables.id });
  },
});
```

## Bundle Optimization

### Import Only What You Need

```typescript
// ✅ Good - Named imports
import { format, parseISO } from 'date-fns';

// ❌ Bad - Import entire library
import * as dateFns from 'date-fns';
```

### Dynamic Imports for Heavy Libraries

```typescript
// ✅ Dynamic import for PDF generation
async function generateReport() {
  const { jsPDF } = await import('jspdf');
  const doc = new jsPDF();
  // ...
}

// ✅ Dynamic import for charts
const RevenueChart = dynamic(
  () => import('recharts').then(mod => mod.LineChart),
  { ssr: false }
);
```

### Analyze Bundle

```bash
# Analyze bundle size
ANALYZE=true bun run build
```

## List Rendering

### Use Proper Keys

```typescript
// ✅ Good - Stable unique keys
{bookings.map((booking) => (
  <BookingCard key={booking.id} booking={booking} />
))}

// ❌ Bad - Index as key
{bookings.map((booking, index) => (
  <BookingCard key={index} booking={booking} />
))}
```

### Virtualize Long Lists

```typescript
import { useVirtualizer } from '@tanstack/react-virtual';

function VirtualizedList({ items }) {
  const parentRef = useRef(null);

  const virtualizer = useVirtualizer({
    count: items.length,
    getScrollElement: () => parentRef.current,
    estimateSize: () => 80, // Estimated row height
  });

  return (
    <div ref={parentRef} className="h-[600px] overflow-auto">
      <div
        style={{ height: `${virtualizer.getTotalSize()}px`, position: 'relative' }}
      >
        {virtualizer.getVirtualItems().map((virtualItem) => (
          <div
            key={virtualItem.key}
            style={{
              position: 'absolute',
              top: 0,
              transform: `translateY(${virtualItem.start}px)`,
            }}
          >
            <BookingCard booking={items[virtualItem.index]} />
          </div>
        ))}
      </div>
    </div>
  );
}
```

